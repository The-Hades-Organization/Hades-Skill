<?xml version="1.0" encoding="utf-8"?>
<!-- Botão primário do painel: token primary, cantos retos. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hades_primary" />
            <stroke android:width="3dp" android:color="@color/hades_ring" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hades_primary" />
        </shape>
    </item>
</selector>
