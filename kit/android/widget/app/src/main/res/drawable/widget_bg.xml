<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão do painel: token card, borda token border de 1dp, cantos retos (radius 0) e filete token primary à esquerda. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hades_border" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/hades_card" />
        </shape>
    </item>
    <item android:bottom="1dp" android:left="1dp" android:top="1dp" android:width="3dp" android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="@color/hades_primary" />
        </shape>
    </item>
</layer-list>
