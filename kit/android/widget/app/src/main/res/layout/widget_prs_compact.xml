<?xml version="1.0" encoding="utf-8"?>
<!-- Widget PRs, tamanho compacto (4x2): contadores de CI e review. Ids root e refresh obrigatórios. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingBottom="2dp"
    android:paddingEnd="6dp"
    android:paddingStart="15dp"
    android:paddingTop="2dp">
    <include layout="@layout/widget_prs_head" />
    <include layout="@layout/widget_prs_summary" />
    <TextView
        android:id="@+id/prs_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:visibility="gone"
        android:textColor="@color/hades_muted_foreground"
        android:textSize="10sp" />
    <include layout="@layout/widget_status_line" />
</LinearLayout>
