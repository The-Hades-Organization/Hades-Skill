<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Sistema, tamanho compacto (4x2): medidor de memória e infra/fila lado a lado. Ids root e refresh obrigatórios. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingBottom="2dp"
    android:paddingEnd="6dp"
    android:paddingStart="15dp"
    android:paddingTop="2dp">
    <include layout="@layout/widget_sistema_head" />
    <include layout="@layout/widget_sistema_memory" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="9dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="0dp">
            <ImageView
                android:id="@+id/infra_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_state_ok" />
            <TextView
                android:id="@+id/infra_short"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hades_foreground"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="0dp">
            <ImageView
                android:id="@+id/queue_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_state_ok" />
            <TextView
                android:id="@+id/queue_short"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hades_foreground"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <include layout="@layout/widget_status_line" />
</LinearLayout>
