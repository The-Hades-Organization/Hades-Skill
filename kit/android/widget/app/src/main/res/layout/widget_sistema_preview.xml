<?xml version="1.0" encoding="utf-8"?>
<!-- Prévia do seletor (previewLayout) do widget Sistema: dados de exemplo. Gerada de widget_sistema.xml. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:paddingEnd="6dp"
    android:paddingStart="15dp"
    android:paddingTop="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark" />
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="7dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_label_sistema"
            android:textStyle="bold"
            android:textColor="@color/hades_foreground"
            android:textSize="13sp" />
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="yes"
            android:src="@drawable/ic_refresh"
            android:padding="8dp"
            android:contentDescription="@string/refresh_desc" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginEnd="9dp"
        android:layout_marginTop="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/memory_percent"
                android:text="39%"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@color/hades_foreground"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/memory_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="3dp"
                android:maxLines="1"
                android:text="@string/memory_label"
                android:textColor="@color/hades_muted_foreground"
                android:textSize="10sp" />
            <TextView
                android:id="@+id/memory_detail"
                android:text="12,5 / 32,0 GB"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="3dp"
                android:maxLines="1"
                android:textColor="@color/hades_muted_foreground"
                android:textSize="11sp" />
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp">
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/memory_bar_ok"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progress="39"
                android:progressDrawable="@drawable/bar_ok"
                android:importantForAccessibility="no" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/memory_bar_warn"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progress="0"
                android:progressDrawable="@drawable/bar_warn"
                android:importantForAccessibility="no"
                android:visibility="gone" />
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/memory_bar_bad"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progress="0"
                android:progressDrawable="@drawable/bar_bad"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="5dp"
        android:layout_marginEnd="9dp"
        android:background="@drawable/divider" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginTop="0dp">
            <ImageView
                android:id="@+id/infra_icon_full"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_state_ok" />
            <TextView
                android:id="@+id/infra_text"
                android:text="infra 6/6 serv · 3/3 cont"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hades_foreground"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="9dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="0dp">
                <ImageView
                    android:id="@+id/queue_icon_full"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_state_run" />
                <TextView
                    android:id="@+id/queue_text"
                    android:text="fila: build-api 4min · 1,2 GB · 2 esperam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/hades_foreground"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:id="@+id/queue_bar_box">
            <ProgressBar
                style="?android:attr/progressBarStyleHorizontal"
                android:id="@+id/queue_bar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="false"
                android:max="100"
                android:maxHeight="6dp"
                android:minHeight="6dp"
                android:progress="4"
                android:progressDrawable="@drawable/bar_info"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/status"
            android:text="atualizado 14:32"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hades_muted_foreground"
            android:textSize="11sp" />
        <TextView
            android:id="@+id/status_problem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone"
            android:textColor="@color/hades_bad"
            android:textSize="11sp" />
    </FrameLayout>
</LinearLayout>
