<?xml version="1.0" encoding="utf-8"?>
<!-- Molde de widget: cabeçalho (marca, título, ↻), o número que importa com rótulo pequeno, um medidor e a linha de
     estado. Os ids root e refresh são obrigatórios (o núcleo liga o toque e o botão). Só views do RemoteViews valem
     (o build recusa as outras) e cor só como @color/hades_*. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:paddingEnd="6dp"
    android:paddingStart="15dp"
    android:paddingTop="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_mark" />
        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/@LABEL_RESOURCE@"
            android:textColor="@color/hades_foreground"
            android:textSize="13sp"
            android:textStyle="bold" />
        <ImageView
            android:id="@+id/refresh"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/refresh_desc"
            android:padding="8dp"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>
    <TextView
        android:id="@+id/count_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@color/hades_ok"
        android:textSize="24sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/count_active_label"
        android:textColor="@color/hades_muted_foreground"
        android:textSize="10sp" />
    <ProgressBar
        android:id="@+id/value_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginEnd="9dp"
        android:layout_marginTop="6dp"
        android:importantForAccessibility="no"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:progress="0"
        android:progressDrawable="@drawable/bar_ok" />
    <include layout="@layout/widget_status_line" />
</LinearLayout>
