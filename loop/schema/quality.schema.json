{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hades.quality/1",
  "title": "Catálogo de qualidade da Hades (reference/projects.md §Catálogo)",
  "type": "object",
  "required": ["schema"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "hades.quality/1"},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "text", "severity"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$", "description": "<grupo-curto>.<regra>, estável"},
          "group": {"enum": ["linguagem", "framework", "praticas", "estilo", "testes", "banco"]},
          "tags": {"type": "array", "items": {"type": "string"}, "description": "linguagem/framework a que a regra se aplica"},
          "text": {"type": "string", "minLength": 10},
          "severity": {"enum": ["bloqueante", "alta", "media", "baixa"]},
          "default": {"enum": ["on", "off"], "description": "estado antes da escolha do usuário (padrão: on)"},
          "check": {
            "type": "object",
            "required": ["kind"],
            "additionalProperties": false,
            "properties": {
              "kind": {"enum": ["grep", "cmd"]},
              "pattern": {"type": "string", "x-regex": "ere"},
              "files": {"type": "string", "description": "glob dos arquivos do diff"},
              "cmd": {"type": "string"}
            }
          }
        }
      }
    },
    "packs": {
      "type": "array",
      "description": "conjuntos nomeados de regras que se ligam e desligam inteiros (reference/quality.md §Pacotes)",
      "items": {
        "type": "object",
        "required": ["id", "title", "rules"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "estável; mesmo id no ~/.claude/hades/quality substitui o do catálogo"},
          "title": {"type": "string", "minLength": 3},
          "text": {"type": "string", "description": "uma linha: a que trabalho o pacote serve"},
          "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"}}
        }
      }
    }
  }
}
